+// Keep the view type independent of the number of squads. This lets the existing
+// resource and bulk-copy interfaces continue to pass a concrete, copyable Squad.
+using squad_hierarchy_t = decltype(::cuda::make_hierarchy(::cuda::block_dims(1u)));
+using squad_block_t     = coop::this_block<squad_hierarchy_t>;
+using warp_group_t      = coop::this_warp<squad_hierarchy_t>;
+using squad_span_t      = ::cuda::std::span<const ::cuda::std::uint32_t>;
+// Name the result explicitly: namespace-scope decltype on the device-only
+// mapping functions is unavailable during nvcc's host compilation pass.
+using squad_mapping_result_t =
+  coop::__mapping_result<coop::__uniform_static_unit_count<::cuda::std::dynamic_extent, ::cuda::std::dynamic_extent>,
+                         true,
+                         true>;
+using squad_group_t =
+  coop::generic_group<::cuda::warp_level,
+                      squad_block_t,
+                      squad_mapping_result_t,
+                      coop::__interwarp_synchronizer_instance<::cuda::std::dynamic_extent>>;
+using squad_group_view_t           = coop::group_view<::cuda::warp_level, squad_group_t, squad_mapping_result_t>;
+using warp_thread_mapping_result_t = coop::__mapping_result<coop::__uniform_static_unit_count<1, 32>, true, true>;
+using warp_thread_group_t          = coop::group_view<::cuda::thread_level, warp_group_t, warp_thread_mapping_result_t>;
+
+[[nodiscard]] _CCCL_DEVICE_API inline warp_group_t make_warp_group()
+{
+  return warp_group_t{squad_hierarchy_t{::cuda::block_dims(blockDim.x)}};
+}
+
+[[nodiscard]] _CCCL_DEVICE_API inline warp_thread_group_t make_warp_thread_group()
+{
+  const warp_group_t warp = _CUB::detail::warpspeed::make_warp_group();
+  return warp_thread_group_t{::cuda::gpu_thread, warp};
+}
